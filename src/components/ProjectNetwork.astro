---
const projects = [
  {
    index: "01",
    code: "SCIENCE ARCHIVE",
    name: "랑이슈타인",
    description: "수학과 자연과학의 이론, 최신 동향과 논문을 분야별로 탐구하고 정리합니다.",
    href: "https://rangistein.pages.dev/",
    current: true,
  },
  {
    index: "02",
    code: "NIGHT-SKY ARCHIVE",
    name: "랑이오스페어",
    description: "직접 관측한 밤하늘과 장비, 이론과 공개 데이터를 하나의 기록으로 연결합니다.",
    href: "https://rang-iosphere.pages.dev/",
  },
  {
    index: "03",
    code: "FINANCIAL ENGINEERING LAB",
    name: "헤지캣",
    description: "금융공학 이론을 검증하고 시뮬레이터와 데이터 기반 실험으로 확장합니다.",
    href: "https://hedgecat.pages.dev/",
  },
] as const;
---

<section class="project-network" aria-labelledby="project-network-title">
  <div class="network-heading">
    <p class="network-eyebrow">RANGI RESEARCH SPECTRUM</p>
    <h2 id="project-network-title">하나의 호기심에서<br />다음 탐구 공간으로</h2>
    <p>과학 이론에서 밤하늘의 실제 관측으로, 다시 데이터와 금융공학의 실험으로 관심사를 확장해 보세요.</p>
  </div>

  <div class="research-spectrum" role="navigation" aria-label="랑이 프로젝트 사이트">
    {projects.map((project) => (
      <a
        class:list={["spectrum-stop", { current: project.current }]}
        href={project.href}
        aria-current={project.current ? "page" : undefined}
        rel={project.current ? undefined : "external"}
      >
        <span class="spectrum-node"><b>{project.index}</b></span>
        <small>{project.code}</small>
        <h3>{project.name}</h3>
        <p>{project.description}</p>
        <strong>{project.current ? "현재 탐구 공간" : "탐구 공간 이동"}<i aria-hidden="true">{project.current ? "●" : "→"}</i></strong>
      </a>
    ))}
  </div>
</section>

<style>
  .project-network { padding: 2rem 1.7rem 2.2rem; overflow: hidden; border: 1px solid #d9e4ee; border-radius: 22px; background: #fff; box-shadow: 0 12px 34px rgba(19,51,84,.065); }
  .network-heading { display: grid; grid-template-columns: .8fr 1.1fr 1fr; align-items: end; gap: 1.5rem; padding-bottom: 1.8rem; border-bottom: 1px solid #dce7ef; }
  .network-eyebrow { align-self: start; margin: .3rem 0 0; color: #286987; font-size: .75rem; font-weight: 800; letter-spacing: .12em; }
  .network-heading h2 { margin: 0; color: #182b3f; font-size: clamp(1.65rem,3vw,2.55rem); line-height: 1.13; letter-spacing: -.045em; }
  .network-heading > p:last-child { margin: 0 0 .15rem; color: #526678; font-size: .92rem; line-height: 1.75; }
  .research-spectrum { position: relative; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); padding-top: 2.5rem; }
  .research-spectrum::before { content: ""; position: absolute; top: 4.15rem; left: 16.66%; right: 16.66%; height: 2px; background: linear-gradient(90deg,#397b96,#63a6a0,#d39b4a); opacity: .45; }
  .spectrum-stop { position: relative; min-width: 0; padding: 0 1.25rem 1rem; text-align: center; transition: transform .2s ease; }
  .spectrum-stop:hover, .spectrum-stop:focus-visible { outline: none; transform: translateY(-4px); }
  .spectrum-node { position: relative; z-index: 1; width: 3.4rem; height: 3.4rem; margin: 0 auto 1.2rem; display: grid; place-items: center; border: 2px solid #78a6b9; border-radius: 50%; background: #fff; box-shadow: 0 0 0 8px #f1f7fa; color: #286987; }
  .spectrum-node b { font-size: .78rem; }
  .spectrum-stop:nth-child(2) .spectrum-node { border-color: #62a29a; color: #397b75; }
  .spectrum-stop:nth-child(3) .spectrum-node { border-color: #d1a25d; color: #986717; }
  .spectrum-stop.current .spectrum-node { background: #286987; color: #fff; box-shadow: 0 0 0 8px #e3f0f4; }
  .spectrum-stop small { display: block; min-height: 2.5em; color: #6d8292; font-size: .67rem; font-weight: 800; letter-spacing: .09em; }
  .spectrum-stop h3 { margin: .4rem 0 .65rem; color: #172b40; font-size: clamp(1.25rem,2.2vw,1.75rem); letter-spacing: -.035em; }
  .spectrum-stop p { min-height: 5.1em; margin: 0; color: #586b7c; font-size: .86rem; line-height: 1.7; }
  .spectrum-stop strong { margin-top: 1.1rem; padding-top: .85rem; display: flex; justify-content: center; gap: .65rem; border-top: 1px solid #e1e9ef; color: #286987; font-size: .76rem; }
  .spectrum-stop strong i { font-style: normal; }
  .spectrum-stop.current strong { color: #187088; }
  @media (max-width: 900px) {
    .network-heading { grid-template-columns: 1fr; gap: .8rem; }
    .research-spectrum { grid-template-columns: 1fr; padding: 2rem 0 0 1rem; }
    .research-spectrum::before { top: 2rem; bottom: 2rem; left: 2.7rem; right: auto; width: 2px; height: auto; background: linear-gradient(#397b96,#63a6a0,#d39b4a); }
    .spectrum-stop { min-height: 170px; padding: 0 0 1.7rem 5.4rem; text-align: left; }
    .spectrum-node { position: absolute; top: 0; left: 0; margin: 0; }
    .spectrum-stop small { min-height: 0; }
    .spectrum-stop p { min-height: 0; }
    .spectrum-stop strong { justify-content: flex-start; }
  }
  @media (max-width: 520px) {
    .project-network { padding: 1.35rem 1.05rem; border-radius: 16px; }
    .research-spectrum { padding-left: 0; }
    .research-spectrum::before { left: 1.7rem; }
    .spectrum-node { width: 3rem; height: 3rem; }
    .spectrum-stop { padding-left: 4.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .spectrum-stop { transition: none; } }
</style>
